<Window x:Class="WWE_Control_Room.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WWE_Control_Room"
        mc:Ignorable="d"
        Title="WWE Control Room" Height="720" Width="1280"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Cursor="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- FŐMENÜ KÁRTYÁK EGYEDI STÍLUSA FIX 350x200 MÉRETHEZ IGAZÍTVA -->
        <Style x:Key="MenuCardStyle" TargetType="TextBox">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Oswald"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid x:Name="CardGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="GlowBorder" CornerRadius="12" Background="Black"/>

                            <Border x:Name="OuterBorder"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#10000000" Offset="0.0"/>
                                                <GradientStop Color="#60000000" Offset="0.5"/>
                                                <GradientStop Color="#E6000000" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Border x:Name="NamePlate"
                                            VerticalAlignment="Bottom"
                                            Background="#CC0B0E14"
                                            BorderBrush="#88FFD700"
                                            BorderThickness="0,2,0,0"
                                            Padding="6,8">

                                        <TextBlock Text="{TemplateBinding Text}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="1"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="NamePlate" Property="Background" Value="#F0000000"/>
                                <Setter TargetName="NamePlate" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EGYEDI ROSTER STÍLUSÚ COMBOBOX STÍLUS (HANGSÚLYOS FÓKUSZ EFFEKTEL) -->
        <Style x:Key="RosterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <!-- Fókusz Ragyogás Réteg -->
                            <Border x:Name="FocusGlow" CornerRadius="10" Background="Transparent" IsHitTestVisible="False"/>

                            <!-- Fő Keret -->
                            <Border x:Name="ComboBorder"
                                    Background="#22222E"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 0 L 5 5 L 10 0 Z"
                                                          Fill="#FFD700"
                                                          HorizontalAlignment="Right"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="15,0,35,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>

                            <!-- Lenyíló Lista Popup -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border x:Name="DropDownBorder"
                                            Background="#181822"
                                            BorderBrush="#FFD700"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="25" Color="Black" Opacity="0.95" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- KIFEJEZETTEN HANGSÚLYOS FÓKUSZ TRIGGER (BILLENTYŰZET / KONTROLLER NAVIGÁCIÓHOZ) -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="3"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="#333346"/>
                                <Setter TargetName="FocusGlow" Property="Background" Value="#FFD700"/>
                                <Setter TargetName="FocusGlow" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="28" ShadowDepth="0" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#2D2D3D"/>
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Margin="2"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#33FFD700"/>
                                            <Setter TargetName="ItemBorder" Property="TextElement.Foreground" Value="#FFD700"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FFD700"/>
                                            <Setter TargetName="ItemBorder" Property="TextElement.Foreground" Value="Black"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ANIMÁCIÓK -->
        <Storyboard x:Key="HideFieldsStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
        </Storyboard>

        <Storyboard x:Key="ShowTableStoryboard">
            <DoubleAnimation Storyboard.TargetName="TableScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TableScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TableViewGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="ShowFieldsStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleX" From="0" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleY" From="0" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- DATAGRID STÍLUSOK -->
        <Style x:Key="CustomColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,0,15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#22222E"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="5,8">
                            <SelectiveScrollingGrid>
                                <DataGridCellsPresenter/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#33FFD700"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- HÁTTÉRVIDEÓ -->
        <MediaElement x:Name="BgVideo"
                      Source="bgVideo.mp4" 
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Close"
                      Stretch="UniformToFill"
                      MediaOpened="BgVideo_MediaOpened"
                      MediaEnded="BgVideo_MediaEnded"
                      Volume="0"
                      IsHitTestVisible="False"
                      Focusable="False"/>

        <!-- 2x2 MEZŐ HÁLÓZAT (FŐMENÜ FIX KÁRTYÁKKAL) -->
        <Grid x:Name="FieldsGrid" RenderTransformOrigin="0.5,0.5" Margin="475,0,0,0" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FieldsScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Box1" Grid.Row="0" Grid.Column="0" Style="{StaticResource MenuCardStyle}" IsReadOnly="True" Text="CALENDAR">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box2" Grid.Row="0" Grid.Column="1" Style="{StaticResource MenuCardStyle}" IsReadOnly="True" Text="ROSTER">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box3" Grid.Row="1" Grid.Column="0" Style="{StaticResource MenuCardStyle}" IsReadOnly="True" Text="BOOK A SHOW!">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box4" Grid.Row="1" Grid.Column="1" Style="{StaticResource MenuCardStyle}" IsReadOnly="True" Text="OPTIONS">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
        </Grid>

        <!-- DATAGRID (ROSTER) NÉZET -->
        <Grid x:Name="TableViewGrid" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TableScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Border Background="#F0121218" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="16" Width="800" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="WRESTLERS" FontSize="24" FontWeight="Bold" Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <DataGrid x:Name="PlayerGrid"
                              Height="420"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              RowBackground="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              RowStyle="{StaticResource CustomRowStyle}"
                              CellStyle="{StaticResource CustomCellStyle}"
                              ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                              Focusable="True"
                              Margin="0,0,0,15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RANK" Binding="{Binding Rank}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFD700"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="17"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="OVERALL" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFD700" CornerRadius="6" Padding="12,5" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Score}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="[ W / S or Arrows ] Move   |   [ Enter ] Select   |   [ ESC ] Go Back"
                               Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOOK A SHOW NÉZET -->
        <Grid x:Name="BookShowGrid" Visibility="Collapsed">
            <Grid Background="#E505060A"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="20" Padding="45,35" Width="880"
                    Background="#F0121218" BorderBrush="#FFD700" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" Color="#FFD700" Opacity="0.3" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <!-- FEJLÉC -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock Text="⚡" Foreground="#FFD700" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="BOOK A SHOW!" 
                                   Foreground="White" FontSize="28" FontWeight="Black" 
                                   FontFamily="Oswald, Impact, Segoe UI"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#FFD700" Opacity="0.8" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="⚡" Foreground="#FFD700" FontSize="26" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- ESEMÉNY TÍPUS -->
                    <Border Background="#181822" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="12" Padding="25,16" Margin="0,0,0,25">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✦ SELECT EVENT TYPE ✦" Foreground="#FFD700" FontSize="11" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ComboBox x:Name="EventTypeCombo" Style="{StaticResource RosterComboBoxStyle}" Width="420" BorderBrush="#FFD700">
                                <ComboBoxItem Content="MATCH" IsSelected="True"/>
                                <ComboBoxItem Content="PROMO"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- PÁROSÍTÁS -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RED CORNER -->
                        <Border Grid.Column="0" Background="#181822" BorderBrush="#FF0044" BorderThickness="1.5" CornerRadius="14" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#FF0044" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="#33FF0044" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="WRESTLER" Foreground="#FF6B8B" FontSize="11" FontWeight="Black"/>
                                </Border>
                                <ComboBox x:Name="Player1Combo" 
                                          Style="{StaticResource RosterComboBoxStyle}" 
                                          BorderBrush="#FF0044" 
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>

                        <!-- VS BADGE -->
                        <Grid Grid.Column="1" Margin="22,0">
                            <Ellipse Width="60" Height="60" Fill="#181822" Stroke="#FFD700" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" Color="#FFD700" Opacity="0.6" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="VS" Foreground="#FFD700" FontSize="22" FontWeight="Black" 
                                       FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="Black" ShadowDepth="2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>

                        <!-- BLUE CORNER -->
                        <Border Grid.Column="2" Background="#181822" BorderBrush="#0088FF" BorderThickness="1.5" CornerRadius="14" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#0088FF" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="#330088FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="WRESTLER" Foreground="#66B5FF" FontSize="11" FontWeight="Black"/>
                                </Border>
                                <ComboBox x:Name="Player2Combo" 
                                          Style="{StaticResource RosterComboBoxStyle}" 
                                          BorderBrush="#0088FF" 
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BOOK MATCH GOMB -->
                    <Button x:Name="BookButton" Content="⚡ BOOK MATCH NOW ⚡" Width="340" Height="56" 
                            FontSize="17" FontWeight="Black" Foreground="White" Cursor="Hand" Focusable="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="btnGlow" CornerRadius="10" Background="#FF0033" Opacity="0.4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="25" Color="#FF0033" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border x:Name="btnBorder" CornerRadius="10" BorderThickness="2" BorderBrush="#FFD700">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E50914" Offset="0.0"/>
                                                <GradientStop Color="#B30006" Offset="0.5"/>
                                                <GradientStop Color="#E50914" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="3"/>
                                        <Setter TargetName="btnGlow" Property="Opacity" Value="1"/>
                                        <Setter TargetName="btnGlow" Property="Background" Value="#FFD700"/>
                                        <Setter TargetName="btnGlow" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="40" Color="#FFD700" Opacity="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnGlow" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>

            <Grid x:Name="MatchDialog" Visibility="Collapsed" Background="#E6030308">
                <Border Background="#12121D" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="18" Padding="45,35" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" Color="#FFD700" Opacity="0.5" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#33FFD700" CornerRadius="6" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="SEGMENT" Foreground="#FFD700" FontSize="12" FontWeight="Black"/>
                        </Border>
                        <TextBlock x:Name="MatchText" Text="MATCH BOOKED!" Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="30" Margin="0,0,0,25">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#FF0033" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Border Background="#1A1B28" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center">
                            <TextBlock Text="[ Press ENTER or ESC to close ]" Foreground="#A0A0B0" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- KILÉPŐ ABLAK -->
        <Grid x:Name="ExitDialog" Visibility="Collapsed" Panel.ZIndex="1000" Background="#CC000000">
            <Border Background="#222222" BorderBrush="Orange" BorderThickness="3" CornerRadius="12" Width="500" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Do you want to quit?" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,25" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#333333" BorderBrush="LightGreen" BorderThickness="2" CornerRadius="6" Padding="15,10" Margin="10">
                            <TextBlock Text="[ Enter ] Yes" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#333333" BorderBrush="Red" BorderThickness="2" CornerRadius="6" Padding="15,10" Margin="10">
                            <TextBlock Text="[ Esc ] No" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>