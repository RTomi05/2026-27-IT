<Window x:Class="WWE_Control_Room.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WWE_Control_Room"
        mc:Ignorable="d"
        Title="WWE Control Room" Height="720" Width="1280"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Cursor="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- FŐMENÜ KÁRTYÁK EGYEDI STÍLUSA ÉS ANIMÁCIÓI -->
        <Style x:Key="MenuCardStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Oswald"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid x:Name="CardGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="GlowBorder" CornerRadius="14" Background="Black"/>

                            <Border x:Name="OuterBorder"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#20000000" Offset="0.0"/>
                                                <GradientStop Color="#80000000" Offset="0.5"/>
                                                <GradientStop Color="#E6000000" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Border x:Name="NamePlate"
                                            VerticalAlignment="Bottom"
                                            Background="#CC0B0E14"
                                            BorderBrush="#88FFD700"
                                            BorderThickness="0,2,0,0"
                                            Padding="10,12">

                                        <TextBlock Text="{TemplateBinding Text}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="1"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="4"/>
                                <Setter TargetName="NamePlate" Property="Background" Value="#F0000000"/>
                                <Setter TargetName="NamePlate" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFD700" BlurRadius="35" ShadowDepth="0" Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ANIMÁCIÓK -->
        <Storyboard x:Key="HideFieldsStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseIn" Amplitude="0.6"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
        </Storyboard>

        <Storyboard x:Key="ShowTableStoryboard">
            <DoubleAnimation Storyboard.TargetName="TableScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TableScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TableViewGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="ShowFieldsStoryboard">
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleX" From="0" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsScale" Storyboard.TargetProperty="ScaleY" From="0" To="1.0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FieldsGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- DATAGRID STÍLUSOK -->
        <Style x:Key="CustomColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,0,15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>

        <Style x:Key="CustomCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#22222E"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="5,8">
                            <SelectiveScrollingGrid>
                                <DataGridCellsPresenter/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#33FFD700"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- HÁTTÉRVIDEÓ -->
        <MediaElement x:Name="BgVideo"
                      Source="bgVideo.mp4" 
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Close"
                      Stretch="UniformToFill"
                      MediaOpened="BgVideo_MediaOpened"
                      MediaEnded="BgVideo_MediaEnded"
                      Volume="0"
                      IsHitTestVisible="False"
                      Focusable="False"/>

        <!-- 2x2 MEZŐ HÁLÓZAT (FŐMENÜ) -->
        <Grid x:Name="FieldsGrid" RenderTransformOrigin="0.5,0.5" Margin="40">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FieldsScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Box1" Grid.Row="0" Grid.Column="0" Style="{StaticResource MenuCardStyle}" Margin="15" IsReadOnly="True" Text="CALENDAR">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box2" Grid.Row="0" Grid.Column="1" Style="{StaticResource MenuCardStyle}" Margin="15" IsReadOnly="True" Text="ROSTER">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box3" Grid.Row="1" Grid.Column="0" Style="{StaticResource MenuCardStyle}" Margin="15" IsReadOnly="True" Text="BOOK A SHOW!">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>

            <TextBox x:Name="Box4" Grid.Row="1" Grid.Column="1" Style="{StaticResource MenuCardStyle}" Margin="15" IsReadOnly="True" Text="OPTIONS">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
        </Grid>

        <!-- DATAGRID (ROSTER) NÉZET -->
        <Grid x:Name="TableViewGrid" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="TableScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Border Background="#F0121218" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="16" Width="800" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="#FFD700" BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="RÉSZTVEVŐK ÉS STATISZTIKÁK" FontSize="24" FontWeight="Bold" Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <DataGrid x:Name="PlayerGrid"
                              Height="420"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              RowBackground="Transparent"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              RowStyle="{StaticResource CustomRowStyle}"
                              CellStyle="{StaticResource CustomCellStyle}"
                              ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                              Focusable="True"
                              Margin="0,0,0,15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RANG" Binding="{Binding Rank}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFD700"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="NÉV" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="17"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="ÉRTÉKELÉS" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFD700" CornerRadius="6" Padding="12,5" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Score}" Foreground="Black" FontWeight="Bold" FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="[ W / S vagy Nyilak ] Kijelölés   |   [ Enter ] Kiválasztás   |   [ ESC ] Vissza"
                               Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOOK A SHOW NÉZET -->
        <Grid x:Name="BookShowGrid" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#E60A0A0E" BorderBrush="#FF0033" BorderThickness="1.5"
                    CornerRadius="16" Padding="40,30" Width="820">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.9" ShadowDepth="10"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="BOOK A SHOW" 
                               Foreground="#FFFFFF" FontSize="28" FontWeight="Black" 
                               HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="12" Color="#FF0033" Opacity="0.8" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- ESEMÉNY TÍPUS -->
                    <Border Background="#161622" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="10" Padding="20,15" Margin="0,0,0,25">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SELECT EVENT TYPE" Foreground="#A0A0B0" FontSize="11" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox x:Name="EventTypeCombo" Width="380" Height="40" FontSize="15" FontWeight="SemiBold"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      Background="#222232" Foreground="White">
                                <ComboBoxItem Content="RAW - Main Event" IsSelected="True"/>
                                <ComboBoxItem Content="SmackDown - Title Match"/>
                                <ComboBoxItem Content="WrestleMania - Main Event"/>
                                <ComboBoxItem Content="Royal Rumble - Fatal 4-Way"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- PÁROSÍTÁS -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RED CORNER -->
                        <Border Grid.Column="0" Background="#14141F" BorderBrush="#FF0033" BorderThickness="1.5" CornerRadius="12" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#FF0033" Opacity="0.25" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="RED CORNER [ ENTER ]" Foreground="#FF4D6D" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ComboBox x:Name="Player1Combo" Height="40" FontSize="15" FontWeight="Bold" DisplayMemberPath="Name"
                                          Background="#222230" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- VS BADGE -->
                        <Grid Grid.Column="1" Margin="20,0">
                            <Ellipse Width="54" Height="54" Fill="#FF0033">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="20" Color="#FF0033" Opacity="0.9" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="VS" Foreground="White" FontSize="20" FontWeight="Black" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- BLUE CORNER -->
                        <Border Grid.Column="2" Background="#14141F" BorderBrush="#0088FF" BorderThickness="1.5" CornerRadius="12" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Color="#0088FF" Opacity="0.25" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="BLUE CORNER [ ENTER ]" Foreground="#4DABFF" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ComboBox x:Name="Player2Combo" Height="40" FontSize="15" FontWeight="Bold" DisplayMemberPath="Name"
                                          Background="#222230" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BOOK MATCH GOMB -->
                    <Button x:Name="BookButton" Content="BOOK MATCH NOW" Width="300" Height="52" 
                            FontSize="16" FontWeight="Black" Foreground="White" Cursor="Hand" Focusable="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#FF4D6D">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E50914" Offset="0.0"/>
                                            <GradientStop Color="#8A0008" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                        <Setter TargetName="btnBorder" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="btnBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="25" Color="#FF0033" Opacity="1"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>

            <!-- MECCS KIÍRÓ POPUP -->
            <Grid x:Name="MatchDialog" Visibility="Collapsed" Background="#F2050508">
                <Border Background="#12121A" BorderBrush="#FF0033" BorderThickness="2" CornerRadius="16" Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#FF0033" Opacity="0.6" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="OFFICIAL MATCH CARD" Foreground="#FF0033" FontSize="13" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock x:Name="MatchText" Text="MATCH BOOKED!" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" LineHeight="28" Margin="0,0,0,25"/>
                        <Border Background="#1F1F2C" CornerRadius="6" Padding="14,8" HorizontalAlignment="Center">
                            <TextBlock Text="[ Nyomj ENTER-t vagy ESC-et a bezáráshoz ]" Foreground="#A0A0B0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- KILÉPŐ ABLAK -->
        <Grid x:Name="ExitDialog" Visibility="Collapsed" Panel.ZIndex="1000" Background="#CC000000">
            <Border Background="#222222" BorderBrush="Orange" BorderThickness="3" CornerRadius="12" Width="500" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ki szeretnél lépni a játékból?" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,25" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#333333" BorderBrush="LightGreen" BorderThickness="2" CornerRadius="6" Padding="15,10" Margin="10">
                            <TextBlock Text="[ Enter ] Igen" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#333333" BorderBrush="Red" BorderThickness="2" CornerRadius="6" Padding="15,10" Margin="10">
                            <TextBlock Text="[ Esc ] Nem" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>