<Window x:Class="WWE_Control_Room.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WWE_Control_Room"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Cursor="None">
    <!-- Hozzáadva a Loaded esemény -->

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="5"/>

            <!-- EGÉR LETILTÁSA: Figyelmen kívül hagyja az egérkattintásokat és a kurzort -->
            <Setter Property="IsHitTestVisible" Value="False"/>

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="BorderBrush" Value="Orange"/>
                    <Setter Property="BorderThickness" Value="5"/>
                    <Setter Property="Panel.ZIndex" Value="1"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="932*"/>
            <ColumnDefinition Width="349*"/>
        </Grid.ColumnDefinitions>
        <MediaElement x:Name="BgVideo"
                      Source="bgVideo.mp4" 
                      LoadedBehavior="Play"
                      UnloadedBehavior="Close"
                      Stretch="UniformToFill"
                      MediaEnded="BgVideo_MediaEnded"
                      Volume="0"
                      IsHitTestVisible="False"
                      Focusable="False" Grid.ColumnSpan="2"/>

        <Grid Margin="10,10,10,10" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Az első mezőnek adtunk egy x:Name="Box1" nevet, hogy hivatkozhassunk rá C#-ban -->
            <TextBox x:Name="Box1" Grid.Row="0" Grid.Column="0" Margin="232,98,592,22" IsReadOnly="True" Text="Mező 1 (Bal Fent)" Grid.ColumnSpan="2">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="108,98,108,22" IsReadOnly="True" Text="Mező 2 (Jobb Fent)">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
            <TextBox Grid.Row="1" Grid.Column="0" Margin="232,23,592,107" IsReadOnly="True" Text="Mező 3 (Bal Lent)" Grid.ColumnSpan="2">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="107,23,108,107" IsReadOnly="True" Text="Mező 4 (Jobb Lent)">
                <TextBox.Background>
                    <ImageBrush ImageSource="Images/brave.jpg" Stretch="UniformToFill"/>
                </TextBox.Background>
            </TextBox>
        </Grid>
    </Grid>
</Window>